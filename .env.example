# Copy to .env to override defaults. All values are optional for the local mock MVP.
MVP_DATA_DIR=data
MVP_DB_PATH=data/contracts.duckdb
MVP_PDF_DIR=data/pdfs
MVP_ADMIN_NAME=Admin

# auto | weasyprint | playwright | headless | minimal
MVP_PDF_ENGINE=auto
# Optional: path to a Chrome/Edge executable for the headless engine
# MVP_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# auto | mock | dropbox_sign  (auto uses dropbox_sign only when the key below is set)
MVP_SIGNATURE_PROVIDER=auto
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_TEST_MODE=1
